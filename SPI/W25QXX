#include "stm32f10x.h"
#include "delay.h"

void INITSPI1(void);
void SPITransmitReceive(SPI_TypeDef *SPIx, const uint8_t *pDataTx, uint8_t *pDataRx, uint8_t Size);
void App_W25Q64_SaveByte(uint8_t Byte);
uint8_t App_W25Q64_LoadByte(void);
void OnBoardLed_Init(void);
void OnBoardLed_Toggle(void);
void ButtonInit(void);
uint8_t ButtonScan(void);

int main(void)
{
	INITSPI1();
	OnBoardLed_Init();
	ButtonInit();

	while (1) {
		if (ButtonScan()) {
			OnBoardLed_Toggle();
		}
	}
}

void INITSPI1(void)
{
	GPIO_InitTypeDef gpiostruct;
	SPI_InitTypeDef initstruct;

	//重映射
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_AFIO, ENABLE);
	GPIO_PinRemapConfig(GPIO_Remap_SPI1, ENABLE);              //重映射SPI1到PB3/4/5
	GPIO_PinRemapConfig(GPIO_Remap_SWJ_JTAGDisable, ENABLE);   //释放 PA15/PB3/PB4

	//开启时钟
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_SPI1, ENABLE);
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);

	//SCK、MOSI：复用推挽
	gpiostruct.GPIO_Pin = GPIO_Pin_3 | GPIO_Pin_5;
	gpiostruct.GPIO_Mode = GPIO_Mode_AF_PP;
	gpiostruct.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_Init(GPIOB, &gpiostruct);

	//MISO：浮空输入
	gpiostruct.GPIO_Pin = GPIO_Pin_4;
	gpiostruct.GPIO_Mode = GPIO_Mode_IN_FLOATING;
	gpiostruct.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_Init(GPIOB, &gpiostruct);

	//CS：通用推挽，默认高
	gpiostruct.GPIO_Pin = GPIO_Pin_15;
	gpiostruct.GPIO_Mode = GPIO_Mode_Out_PP;
	gpiostruct.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_Init(GPIOA, &gpiostruct);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	//SPI Mode0
	initstruct.SPI_Mode = SPI_Mode_Master;
	initstruct.SPI_DataSize = SPI_DataSize_8b;
	initstruct.SPI_BaudRatePrescaler = SPI_BaudRatePrescaler_64;
	initstruct.SPI_CPOL = SPI_CPOL_Low;
	initstruct.SPI_CPHA = SPI_CPHA_1Edge;
	initstruct.SPI_FirstBit = SPI_FirstBit_MSB;
	initstruct.SPI_Direction = SPI_Direction_2Lines_FullDuplex;
	initstruct.SPI_NSS = SPI_NSS_Soft;
	initstruct.SPI_CRCPolynomial = 7;
	SPI_Init(SPI1, &initstruct);

	SPI_NSSInternalSoftwareConfig(SPI1, SPI_NSSInternalSoft_Set);
	SPI_Cmd(SPI1, ENABLE); /* 之后一直保持使能 */
}

void SPITransmitReceive(SPI_TypeDef *SPIx, const uint8_t *pDataTx, uint8_t *pDataRx, uint8_t Size)
{
	uint8_t i;

	if (Size == 0 || pDataTx == 0 || pDataRx == 0) {
		return;
	}

	for (i = 0; i < Size; i++) {
		while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_TXE) == RESET);
		SPI_I2S_SendData(SPIx, pDataTx[i]);
		while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_RXNE) == RESET);
		pDataRx[i] = (uint8_t)SPI_I2S_ReceiveData(SPIx);
	}

	while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_BSY) == SET);
}

void App_W25Q64_SaveByte(uint8_t Byte)
{
	uint8_t buffer[10];
	uint32_t t0;

	//写使能
	buffer[0] = 0x06;
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
	SPITransmitReceive(SPI1, buffer, buffer, 1);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	//扇区擦除
	buffer[0] = 0x20;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
	SPITransmitReceive(SPI1, buffer, buffer, 4);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	//等待空闲
	t0 = GetTick();
	while (1) {
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
		buffer[0] = 0x05;
		SPITransmitReceive(SPI1, buffer, buffer, 1);
		buffer[0] = 0xff;
		SPITransmitReceive(SPI1, buffer, buffer, 1);
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);
		if ((buffer[0] & 0x01) == 0) {
			break;
		}
		if ((GetTick() - t0) > 500) {
			return;
		}
	}

	//再次写使能
	buffer[0] = 0x06;
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
	SPITransmitReceive(SPI1, buffer, buffer, 1);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	//页编程
	buffer[0] = 0x02;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;
	buffer[4] = Byte;
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
	SPITransmitReceive(SPI1, buffer, buffer, 5);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	//等待空闲
	t0 = GetTick();
	while (1) {
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
		buffer[0] = 0x05;
		SPITransmitReceive(SPI1, buffer, buffer, 1);
		buffer[0] = 0xff;
		SPITransmitReceive(SPI1, buffer, buffer, 1);
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);
		if ((buffer[0] & 0x01) == 0) {
			break;
		}
		if ((GetTick() - t0) > 500) {
			return;
		}
	}
}

uint8_t App_W25Q64_LoadByte(void)
{
	uint8_t buffer[10];

	buffer[0] = 0x03;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET);
	SPITransmitReceive(SPI1, buffer, buffer, 4);
	buffer[0] = 0xff;
	SPITransmitReceive(SPI1, buffer, buffer, 1);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	return buffer[0];
}

void OnBoardLed_Init(void)
{
	GPIO_InitTypeDef gpiostruct;

	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOC, ENABLE);
	gpiostruct.GPIO_Mode = GPIO_Mode_Out_OD;
	gpiostruct.GPIO_Pin = GPIO_Pin_13;
	gpiostruct.GPIO_Speed = GPIO_Speed_2MHz;
	GPIO_Init(GPIOC, &gpiostruct);
	GPIO_WriteBit(GPIOC, GPIO_Pin_13, Bit_SET); //初始值为灭 
}

void OnBoardLed_Toggle(void)
{
	if (GPIO_ReadOutputDataBit(GPIOC, GPIO_Pin_13) == Bit_SET) {
		GPIO_WriteBit(GPIOC, GPIO_Pin_13, Bit_RESET); //点亮
	} else {
		GPIO_WriteBit(GPIOC, GPIO_Pin_13, Bit_SET);   //熄灭 
	}
}

void ButtonInit(void)
{
	GPIO_InitTypeDef gpiostruct;

	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);
	gpiostruct.GPIO_Mode = GPIO_Mode_IPU; //输出上拉，按键按下时接低
	gpiostruct.GPIO_Pin = GPIO_Pin_0;
	gpiostruct.GPIO_Speed = GPIO_Speed_2MHz;
	GPIO_Init(GPIOA, &gpiostruct);
}

// 返回1表示检测到按下
uint8_t ButtonScan(void)
{
	static uint8_t last = 1; //松开

	if (GPIO_ReadInputDataBit(GPIOA, GPIO_Pin_0) == Bit_RESET) {
		Delay(15); //按键消抖
		if (GPIO_ReadInputDataBit(GPIOA, GPIO_Pin_0) == Bit_RESET) {
			if (last == 1) {
				last = 0;
				return 1;
			}
		}
	} else {
		last = 1;
	}
	return 0;
}
