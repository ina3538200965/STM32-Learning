#include "stm32f10x.h"
#include "delay.h"
#include "math.h"
void GPIOInit(void);
void PWMInit(void);

int main(void){
	GPIOInit();
	PWMInit();
	while(1){
		//获取当前值
		float currenttime =GetTick() *1.0e-3f;
		float duty =0.5*(sin(2*3.14*currenttime)+1);
		uint16_t ccr1=duty *1000;
		
		TIM_SetCompare1(TIM1,ccr1);

	}
}

void GPIOInit(void){
	
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA,ENABLE);
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB,ENABLE);
	
	GPIO_InitTypeDef gpio;
	
	//PA8
	gpio.GPIO_Mode=GPIO_Mode_AF_PP;
	gpio.GPIO_Pin=GPIO_Pin_8;
	gpio.GPIO_Speed=GPIO_Speed_2MHz;
	GPIO_Init(GPIOA,&gpio);
	
	//PB13
	gpio.GPIO_Mode=GPIO_Mode_AF_PP;
	gpio.GPIO_Pin=GPIO_Pin_13;
	gpio.GPIO_Speed=GPIO_Speed_2MHz;
	GPIO_Init(GPIOB,&gpio);
	
}


void PWMInit(void){
	//开启TIM1时钟
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_TIM1,ENABLE);
	
	//创建一个结构体
	TIM_TimeBaseInitTypeDef tim;
	tim.TIM_Period=999;
	tim.TIM_Prescaler=71;
	tim.TIM_RepetitionCounter=0;
	tim.TIM_CounterMode=TIM_CounterMode_Up;
	tim.TIM_ClockDivision=TIM_CKD_DIV1;
	
	TIM_TimeBaseInit(TIM1,&tim);
	
	//开启ARR预加载
	TIM_ARRPreloadConfig(TIM1,ENABLE);
	//闭合Tim
	TIM_Cmd(TIM1,ENABLE);
	
	//初始化输出比较
	TIM_OCInitTypeDef timoc;

	timoc.TIM_OCMode=TIM_OCMode_PWM1;//CCR>CNT:输出高电平
	timoc.TIM_OCPolarity=TIM_OCPolarity_High;//CHX极性高
	timoc.TIM_OCNPolarity=TIM_OCNPolarity_High; //CHXN极性高
	timoc.TIM_OutputState=TIM_OutputState_Enable;//闭合开关
	timoc.TIM_OutputNState=TIM_OutputNState_Enable;//闭合开关
	timoc.TIM_Pulse=0;//设置CCR的初值
	timoc.TIM_OCIdleState=TIM_OCIdleState_Reset;//空闲状态输出低电平
	timoc.TIM_OCNIdleState=TIM_OCNIdleState_Reset;
	
	TIM_OC1Init(TIM1,&timoc);
	
	//开启CCR1预加载
	TIM_OC1PreloadConfig(TIM1,TIM_OCPreload_Enable);
	
	//闭合MOE总开关
	 TIM_CtrlPWMOutputs(TIM1,ENABLE);
	 
	 
}

